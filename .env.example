# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
GROQ_API_KEY=your_groq_api_key_here

# ── Target Configuration ──────────────────────────────────────────────────────
# The Discord display name to use in roasts (default: Donovan)
TARGET_NAME=Donovan

# Comma-separated list of Discord usernames (not display names) belonging to
# the target. Used to detect when the target is speaking or present in voice.
TARGET_USERNAMES=itsrebrand,streamerweiner

# Stock ticker symbol for the target (default: first 8 chars of TARGET_NAME uppercased)
TARGET_STOCK_TICKER=DONOVAN

# ── Channel / Server ──────────────────────────────────────────────────────────
ROAST_CHANNEL_ID=your_channel_id_here
VOICE_CHANNEL_ID=your_voice_channel_id_here

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_to_something_secret

# ── Sports Betting ────────────────────────────────────────────────────────────
# Free key at https://the-odds-api.com/ (500 req/month free tier — only used for odds)
# Score polling and bet settlement use ESPN's free API (no key needed)
# Leave blank to disable odds display; bets on already-loaded games still settle
ODDS_API_KEY=
ODDS_API_KEY_2=
